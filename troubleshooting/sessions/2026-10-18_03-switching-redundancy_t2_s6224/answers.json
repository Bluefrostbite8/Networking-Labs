        ]
      },
      "key_clue": "show ip interface Vlan10 on Core1: 'Helper address is 10.1.10.10' where the server is 192.168.1.1",
      "better_fix_if_temporary": "Point both relays back at the DHCP server and save with 'write memory' on Core1 and Core2."
    }
